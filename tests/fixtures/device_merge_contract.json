              {"rloc16": "0x1000", "children": [{"rloc16": "0x1001", "status": "online"}]}
            ]
          },
          {
            "name": "beta.json",
            "records": [
              {"rloc16": "0x1000", "children": [{"rloc16": "0x1001", "sample": 21}]}
            ]
          }
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0x1000",
            "children": [{"rloc16": "0x1001", "status": "online", "sample": 21}],
            "_source_files": ["alpha.json", "beta.json"]
          }
        ]
      }
    },
    {
      "id": "children-and-childtable-distinct",
      "area": "child",
      "operation": "merge",
      "enforcement": "contract",
