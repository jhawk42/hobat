    {
      "id": "normalize-extaddress-case-whitespace",
      "area": "normalization",
      "operation": "normalize",
      "enforcement": "contract",
      "description": "Canonical extAddress identity is trimmed and lowercased.",
      "inputs": {
        "record": {"extAddress": " AA11BB22CC33DD44 "}
      },
      "expected": {
        "contract": {"extAddress": "aa11bb22cc33dd44"}
      }
    },
    {
      "id": "normalize-identity-idempotent",
      "area": "normalization",
      "operation": "normalize",
      "enforcement": "contract",
      "description": "Canonical identity aliases remain stable across repeated normalization.",
      "inputs": {
        "record": {
          "rloc16": "0xabcd",
          "_source_files": []
        },
        "repeat": 2
      },
      "expected": {
        "contract": {
          "rloc16": "0xabcd",
          "_source_files": []
        }
      }
    },
    {
      "id": "normalize-rloc16-case",
      "area": "identity",
      "operation": "normalize",
      "enforcement": "contract",
      "description": "RLOC16 identity uses lowercase canonical text.",
      "inputs": {
        "record": {
          "extAddress": "aa11bb22cc33dd44",
          "extaddr": "aa11bb22cc33dd44",
          "rloc16": "0XABCD",
          "_source_files": []
        }
      },
      "expected": {
        "contract": {
          "extAddress": "aa11bb22cc33dd44",
          "rloc16": "0xabcd",
          "_source_files": []
        }
      }
    },
    {
      "id": "merge-empty-scalar-and-provenance",
      "area": "provenance",
      "operation": "merge",
      "enforcement": "contract",
      "description": "A non-empty scalar fills an empty value and source provenance is retained in order.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {
            "name": "alpha.json",
            "records": [
              {
                "rloc16": "0xabcd",
                "status": ""
              }
            ]
          },
          {
            "name": "beta.json",
            "records": [
              {
                "rloc16": "0xabcd",
                "status": "online",
                "sample": 21
              }
            ]
          }
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0xabcd",
            "status": "online",
            "sample": 21,
            "_source_files": ["alpha.json", "beta.json"]
          }
        ]
      }
    },
    {
      "id": "identity-missing",
      "area": "identity",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Records without a merge identity follow one explicit retention policy.",
      "inputs": {
        "strategy": "by-identity",
        "sources": [
          {"name": "unknown.json", "records": [{"status": "detached"}]}
        ]
      },
      "expected": {
        "contract": [{"status": "detached", "_source_files": ["unknown.json"]}]
      }
    },
    {
      "id": "scalar-existing-nonempty-incoming-empty",
      "area": "scalar",
      "operation": "merge",
      "enforcement": "contract",
      "description": "An empty incoming scalar does not replace an existing value.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {"name": "alpha.json", "records": [{"rloc16": "0xabcd", "status": "online"}]},
          {"name": "beta.json", "records": [{"rloc16": "0xabcd", "status": ""}]}
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0xabcd",
            "status": "online",
            "_source_files": ["alpha.json", "beta.json"]
          }
        ]
      }
    },
    {
      "id": "scalar-equal-nonempty",
      "area": "scalar",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Equal non-empty scalar values merge without a conflict.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {"name": "alpha.json", "records": [{"rloc16": "0xabcd", "status": "online"}]},
          {"name": "beta.json", "records": [{"rloc16": "0xabcd", "status": "online"}]}
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0xabcd",
            "status": "online",
            "_source_files": ["alpha.json", "beta.json"]
          }
        ]
      }
    },
    {
      "id": "scalar-source-priority-reversed-input",
      "area": "precedence",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Configured source priority wins regardless of input order.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {
            "name": "td-otbr-restapi-diagnostics.json",
            "records": [{"rloc16": "0xabcd", "status": "low"}]
          },
          {
            "name": "td-otbr-cli-networkdiag-fetch-all.json",
            "records": [{"rloc16": "0xabcd", "status": "high"}]
          }
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0xabcd",
            "status": "high",
            "_source_files": [
              "td-otbr-cli-networkdiag-fetch-all.json",
              "td-otbr-restapi-diagnostics.json"
            ],
            "_merge_conflicts": [
              {"path": "status", "current": "high", "incoming": "low"}
            ]
          }
        ]
      }
    },
    {
      "id": "precedence-unknown-source-stable-order",
      "area": "precedence",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Unknown sources use stable input order for equal default priority.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {"name": "unknown-a.json", "records": [{"rloc16": "0xabcd", "status": "first"}]},
          {"name": "unknown-b.json", "records": [{"rloc16": "0xabcd", "status": "second"}]}
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0xabcd",
            "status": "first",
            "_source_files": ["unknown-a.json", "unknown-b.json"],
            "_merge_conflicts": [
              {"path": "status", "current": "first", "incoming": "second"}
            ]
          }
        ]
      }
    },
    {
      "id": "children-merge-by-rloc16",
      "area": "child",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Child observations with the same RLOC16 merge within one parent.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {
            "name": "alpha.json",
