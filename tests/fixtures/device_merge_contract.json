      }
    },
    {
      "id": "route-sequence-wraparound-250-to-5",
      "area": "route",
      "operation": "merge",
      "enforcement": "contract",
      "description": "RFC 1982 sequence comparison treats 5 as newer than 250.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {
            "name": "alpha.json",
            "records": [
              {
                "rloc16": "0x1000",
                "route": {"idSequence": 250, "routeData": [{"routeId": 1, "routeCost": 5}]}
              }
            ]
          },
          {
            "name": "beta.json",
            "records": [
              {
                "rloc16": "0x1000",
                "route": {"idSequence": 5, "routeData": [{"routeId": 1, "routeCost": 2}]}
              }
            ]
          }
        ]
      },
      "expected": {
        "contract": [
          {
            "rloc16": "0x1000",
            "route": {"idSequence": 5, "routeData": [{"routeId": 1, "routeCost": 2}]},
            "_source_files": ["alpha.json", "beta.json"]
          }
        ]
      }
    },
    {
      "id": "route-known-partition-mismatch",
      "area": "route",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Route observations from different known partitions do not merge.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {
            "name": "alpha.json",
            "records": [{"rloc16":"0x1000","leaderData":{"partitionId":"0x00000001"},"route":{"idSequence":1,"routeData":[{"routeId":1,"routeCost":5}]}}]
          },
          {
            "name": "beta.json",
            "records": [{"rloc16":"0x1000","leaderData":{"partitionId":"0x00000002"},"route":{"idSequence":2,"routeData":[{"routeId":1,"routeCost":1}]}}]
          }
        ]
      },
      "expected": {
        "contract": [{
          "rloc16":"0x1000",
          "leaderData":{"partitionId":"0x00000001"},
          "route":{"idSequence":1,"routeData":[{"routeId":1,"routeCost":5}]},
          "_source_files":["alpha.json","beta.json"],
          "_merge_conflicts":[{"path":"leaderData.partitionId","current":"0x00000001","incoming":"0x00000002"}]
        }]
      }
    },
    {
      "id": "conflict-deduplicated",
      "area": "conflict",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Repeated identical conflicts are recorded once with raw values.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {"name":"alpha.json","records":[{"rloc16":"0x1000","status":"online"}]},
          {"name":"beta.json","records":[{"rloc16":"0x1000","status":"offline"}]},
          {"name":"gamma.json","records":[{"rloc16":"0x1000","status":"offline"}]}
        ]
      },
      "expected": {
        "contract": [{
          "rloc16":"0x1000",
          "status":"online",
          "_source_files":["alpha.json","beta.json","gamma.json"],
          "_merge_conflicts":[{"path":"status","current":"online","incoming":"offline"}]
        }]
      }
    },
    {
      "id": "identity-collision-reconciles-nodes",
      "area": "identity",
      "operation": "merge",
      "enforcement": "contract",
      "description": "A bridge observation reconciles nodes matched by two consistent strong identities.",
      "inputs": {
        "strategy": "by-identity",
        "sources": [
          {"name":"alpha.json","records":[{"extAddress":"aa11","status":"online"}]},
          {"name":"beta.json","records":[{"omrIpv6Address":"fd00::1","sample":21}]},
          {"name":"bridge.json","records":[{"extAddress":"aa11","omrIpv6Address":"fd00::1","role":"router"}]}
        ]
      },
      "expected": {
        "contract": [{
          "extAddress":"aa11",
          "status":"online",
          "omrIpv6Address":"fd00::1",
          "sample":21,
          "role":"router",
          "mode.device":"FTD",
          "_source_files":["alpha.json","beta.json","bridge.json"]
        }]
      }
    },
    {
      "id": "mdns-newer-timestamp-wins",
      "area": "mdns",
      "operation": "merge",
      "enforcement": "contract",
      "description": "A newer mDNS observation wins and fills missing service fields from the older record.",
      "inputs": {
        "strategy": "by-rloc16",
        "sources": [
          {"name":"alpha.json","records":[{"rloc16":"0x1000","scope":"_meshcop._udp.local.","recordKey":"first","event":"add","capturedAtEpoch":1,"serviceInfo":{"port":1,"oldOnly":true}}]},
          {"name":"beta.json","records":[{"rloc16":"0x1000","scope":"_meshcop._udp.local.","recordKey":"second","event":"update","capturedAtEpoch":2,"serviceInfo":{"port":2,"newOnly":true}}]}
        ]
      },
      "expected": {
        "contract": [{
          "rloc16":"0x1000",
          "scope":"_meshcop._udp.local.",
          "recordKey":"second",
          "event":"update",
          "capturedAtEpoch":2,
          "serviceInfo":{"port":2,"newOnly":true,"oldOnly":true},
          "_source_files":["alpha.json","beta.json"],
          "_mdns_aliases":{}
        }]
      }
    },
    {
      "id": "unspecified-omr-does-not-merge-devices",
      "area": "identity",
      "operation": "merge",
      "enforcement": "contract",
      "description": "The IPv6 unspecified address is retained as source data but cannot correlate distinct devices.",
      "inputs": {
        "strategy": "by-identity",
        "sources": [
          {"name":"alpha.json","records":[{"extAddress":"0011223344556677","omrIpv6Address":"::","name":"alpha"}]},
          {"name":"beta.json","records":[{"extAddress":"8899aabbccddeeff","omrIpv6Address":"0:0:0:0:0:0:0:0","name":"beta"}]}
        ]
      },
      "expected": {
        "contract": [
          {"extAddress":"0011223344556677","omrIpv6Address":"::","name":"alpha","_source_files":["alpha.json"]},
          {"extAddress":"8899aabbccddeeff","omrIpv6Address":"0:0:0:0:0:0:0:0","name":"beta","_source_files":["beta.json"]}
        ]
      }
    },
    {
      "id": "matter-composite-guard-separates-shared-omr",
      "area": "matter",
      "operation": "merge",
      "enforcement": "contract",
      "description": "Composite guard keeps Matter records with different Fabric and Node identities separate.",
      "inputs": {
        "strategy": "by-identity",
        "options":{"matterIdentityMode":"composite-guard"},
        "sources": [
          {"name":"alpha.json","records":[{"scope":"_matter._tcp.local.","omrIpv6Address":"fd00::1","serviceInfo":{"properties":{"FabricID_compressed":{"decoded":"aaaa"},"NodeID":{"decoded":"0001"}}}}]},
          {"name":"beta.json","records":[{"scope":"_matter._tcp.local.","omrIpv6Address":"fd00::1","serviceInfo":{"properties":{"FabricID_compressed":{"decoded":"bbbb"},"NodeID":{"decoded":"0002"}}}}]}
        ]
      },
      "expected": {
        "contract": [
          {"omrIpv6Address":"fd00::1","scope":"_matter._tcp.local.","serviceInfo":{"properties":{"fabricIdCompressed":{"decoded":"aaaa"},"nodeId":{"decoded":"0001"}}},"_source_files":["alpha.json"],"_mdns_aliases":{"fabricIdCompressedAliases":["aaaa"],"nodeIdAliases":["0001"],"matterFabricNodeAliases":["aaaa|0001"]}},
          {"omrIpv6Address":"fd00::1","scope":"_matter._tcp.local.","serviceInfo":{"properties":{"fabricIdCompressed":{"decoded":"bbbb"},"nodeId":{"decoded":"0002"}}},"_source_files":["beta.json"],"_mdns_aliases":{"fabricIdCompressedAliases":["bbbb"],"nodeIdAliases":["0002"],"matterFabricNodeAliases":["bbbb|0002"]}}
        ]
      }
    }
  ]
