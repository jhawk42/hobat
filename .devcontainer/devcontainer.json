// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// https://mcr.microsoft.com/en-us/artifact/mar/devcontainers/python/about
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {},
		"ghcr.io/devcontainers/features/node:2.1.0": {
			"version": "22"
		}
	},
	"customizations": {
		"vscode": {}
	},
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y ripgrep && python -m pip install -r requirements.txt && python -m pip install -r requirements_test.txt",
	// Use docker container host network to allow access to services running on the host machine
	"runArgs": [
		"--network=host"
	]


}