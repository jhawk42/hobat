{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}"
        },
        {
            "name": "Python Debugger: Python File with args: --debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--debug", "arg2"],
            "cwd": "${fileDirname}" 
        },
        {
            "name": "Python Debugger: Python File with args: --verbose",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--verbose", "arg2"],
            "cwd": "${fileDirname}" 
        },
        {
            "name": "Python Debugger: Python File with args: --test",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--test", "arg2"],
            "cwd": "${fileDirname}" 
        },
        {
            "name": "Python Debugger: Python File with args: --help",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--help", "arg2"],
            "cwd": "${fileDirname}" 
        }
    ]
}