{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}/src"
        },
        {
            "name": "Python Debugger: Python File with args",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": "${command:pickArgs}",
            "cwd": "${fileDirname}",
            "env": {
                "TD_DATA_DIR": "${workspaceFolder}/data"
            }            
        },
        {
            "name": "Python Debugger: Module",
            "type": "debugpy",
            "request": "launch",
            "module": "${input:moduleName}",
            "cwd": "${workspaceFolder}/src"
        },
        {
            "name": "Python cProfile: td_cli with args",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/profile_wrapper_td_cli.py",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}/src"
        }
        ,
        {
            "name": "Python cProfile: td_webserver with args",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/profile_wrapper_td_webserver.py",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}/src"
        }
    ]
}